# Copy to deploy/.env (gitignored) and fill in.

# Hostname the phone will visit. Must match the TLS certificate.
APP_HOST=journal.example.com

# Contents of backend/config/master.key
RAILS_MASTER_KEY=

BACKEND_DATABASE_PASSWORD=

# Default `internal` uses Caddy's own CA (the phone must trust its root cert).
# To use a real cert, e.g. from `tailscale cert`, drop the files in deploy/certs/
# and set: TLS_ARGS=/certs/fullchain.pem /certs/key.pem
# TLS_ARGS=internal
